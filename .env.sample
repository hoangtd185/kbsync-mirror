# Required for uploading: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# HELP_CENTER_URL=https://support.optisigns.com
# HELP_CENTER_LOCALE=en-us
# STORE_DISPLAY_NAME=optibot-kb
# MAX_ARTICLES=            # empty = all articles; set e.g. 40 for a quick test run
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP_TOKENS=60
# UPLOAD_WORKERS=4
# GEMINI_MODEL=gemini-3.8-flash
